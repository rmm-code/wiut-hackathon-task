{
  "name": "pitstop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --prefix web run dev -- --host 127.0.0.1 --port 5173",
    "dev:api": ".venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8000",
    "build": "npm --prefix web run check && npm --prefix web run build",
    "test": "npm --prefix web test && .venv/bin/python -m pytest -q tests",
    "check": "npm --prefix web run check && node scripts/check-size.mjs"
  }
}
